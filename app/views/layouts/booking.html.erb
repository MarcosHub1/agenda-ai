<!DOCTYPE html>
<html lang="pt-BR" class="h-full bg-slate-50">
<head>
  <meta charset="utf-8">
  <title><%= content_for(:title) || @booking_tenant&.name || "Agendamento Online" %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  </style>
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>

<body class="min-h-full flex flex-col justify-between bg-slate-100/70 text-slate-800 antialiased selection:bg-indigo-500 selection:text-white">
  <!-- Brand Header -->
  <header class="w-full bg-white border-b border-slate-200/80 sticky top-0 z-20 shadow-sm/50">
    <div class="max-w-2xl mx-auto px-4 py-4 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <% if @booking_tenant&.logo_url.present? %>
          <img src="<%= @booking_tenant.logo_url %>" alt="<%= @booking_tenant.name %>" class="w-10 h-10 rounded-xl object-cover border border-slate-200">
        <% else %>
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-600 flex items-center justify-center font-bold text-white text-base shadow-sm">
            <%= @booking_tenant&.name&.first || "A" %>
          </div>
        <% end %>
        <div>
          <h1 class="text-base font-bold text-slate-900 leading-tight"><%= @booking_tenant&.name %></h1>
          <p class="text-xs text-slate-500 flex items-center gap-1 font-medium">
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
            Horário de <%= @booking_tenant&.timezone || "Brasília" %>
          </p>
        </div>
      </div>

      <% if @booking_tenant %>
        <%= link_to booking_path(tenant_slug: @booking_tenant.slug), class: "text-xs font-semibold text-indigo-600 hover:text-indigo-700 bg-indigo-50 hover:bg-indigo-100/80 px-3 py-1.5 rounded-lg transition-colors" do %>
          Início
        <% end %>
      <% end %>
    </div>
  </header>

  <!-- Flash Alerts -->
  <div class="max-w-2xl w-full mx-auto px-4 pt-4">
    <% if notice.present? %>
      <div class="rounded-xl bg-emerald-50 border border-emerald-200 p-4 mb-4 flex items-center gap-2 text-emerald-800 text-sm shadow-sm">
        <svg class="w-5 h-5 text-emerald-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
        <span><%= notice %></span>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="rounded-xl bg-rose-50 border border-rose-200 p-4 mb-4 flex items-center gap-2 text-rose-800 text-sm shadow-sm">
        <svg class="w-5 h-5 text-rose-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
        </svg>
        <span><%= alert %></span>
      </div>
    <% end %>
  </div>

  <!-- Main Container -->
  <main class="flex-1 max-w-2xl w-full mx-auto px-4 py-4 sm:py-6">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200/90 overflow-hidden">
      <%= yield %>
    </div>
  </main>

  <!-- Footer -->
  <footer class="w-full py-6 text-center text-xs text-slate-400">
    <p>Agendamento seguro proporcionado por <span class="font-semibold text-slate-600">AgendaAI</span></p>
  </footer>
</body>
</html>
