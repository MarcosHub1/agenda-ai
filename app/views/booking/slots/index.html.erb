<div class="p-6 sm:p-8 space-y-6">
  <!-- Step Indicator -->
  <div class="flex items-center justify-between border-b border-slate-100 pb-5">
    <div class="flex items-center space-x-2">
      <span class="w-7 h-7 rounded-full bg-indigo-600 text-white font-bold text-xs flex items-center justify-center">3</span>
      <span class="font-bold text-slate-900 text-sm">Escolha Data e Horário</span>
    </div>
    <span class="text-xs text-slate-400 font-medium">Passo 3 de 4</span>
  </div>

  <!-- Summary of Service and Professional -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 p-3.5 bg-slate-50 rounded-xl border border-slate-200/80">
    <div>
      <p class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider">Serviço</p>
      <p class="text-sm font-bold text-slate-900"><%= @service.name %></p>
      <p class="text-xs text-indigo-600 font-semibold mt-0.5"><%= @service.duration_minutes %> min · <%= format_cents(@service.price_cents, @service.currency) %></p>
    </div>
    <div class="sm:border-l sm:border-slate-200 sm:pl-3">
      <p class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider">Profissional</p>
      <p class="text-sm font-bold text-slate-900"><%= @professional.name %></p>
      <%= link_to "Trocar", booking_professionals_path(tenant_slug: @booking_tenant.slug, service_id: @service.id), class: "text-[11px] font-semibold text-slate-500 hover:text-slate-800" %>
    </div>
  </div>

  <!-- Date Selector (Next 7 days tabs) -->
  <div>
    <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Selecione o Dia</label>
    <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none">
      <% 14.times do |i| %>
        <% current_d = Date.current + i.days %>
        <% is_active = (current_d == @date) %>
        <%= link_to booking_slots_path(tenant_slug: @booking_tenant.slug, service_id: @service.id, professional_id: @professional.id, date: current_d), class: "flex-shrink-0 text-center px-3.5 py-2.5 rounded-xl border transition-all #{is_active ? 'bg-indigo-600 text-white border-indigo-600 shadow-sm font-bold' : 'bg-white text-slate-700 border-slate-200 hover:border-indigo-300'}" do %>
          <span class="block text-[10px] uppercase font-semibold <%= is_active ? 'text-indigo-200' : 'text-slate-400' %>">
            <%= day_name_pt(current_d.wday).first(3) %>
          </span>
          <span class="block text-base font-bold">
            <%= current_d.day %>
          </span>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Available Time Slots Grid -->
  <div>
    <div class="flex items-center justify-between mb-3">
      <h3 class="text-xs font-semibold text-slate-700 uppercase tracking-wider">
        Horários Disponíveis em <%= l(@date, format: :long) %>
      </h3>
      <span class="text-xs text-slate-500"><%= @slots.count { |s| s[:available] } %> horários livres</span>
    </div>

    <% available_slots = @slots.select { |s| s[:available] } %>
    <% if available_slots.any? %>
      <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-2.5">
        <% available_slots.each do |slot| %>
          <%= link_to new_booking_appointment_path(tenant_slug: @booking_tenant.slug, service_id: @service.id, professional_id: @professional.id, starts_at: slot[:starts_at].iso8601), class: "py-2.5 px-3 rounded-xl border border-slate-200 bg-white hover:bg-indigo-50 hover:border-indigo-500 text-center text-sm font-bold text-slate-800 hover:text-indigo-700 shadow-sm transition-all" do %>
            <%= slot[:starts_at].strftime("%H:%M") %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="p-8 text-center bg-slate-50 rounded-2xl border border-slate-200/80">
        <svg class="w-8 h-8 text-slate-400 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
        <p class="text-sm font-semibold text-slate-700">Sem horários disponíveis para esta data.</p>
        <p class="text-xs text-slate-500 mt-1">Por favor, escolha outro dia na barra acima.</p>
      </div>
    <% end %>
  </div>

  <div class="pt-4 border-t border-slate-100 flex justify-start">
    <%= link_to "← Voltar aos Profissionais", booking_professionals_path(tenant_slug: @booking_tenant.slug, service_id: @service.id), class: "text-xs font-semibold text-slate-500 hover:text-slate-800" %>
  </div>
</div>
