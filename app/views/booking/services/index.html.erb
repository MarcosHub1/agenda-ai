<div class="p-6 sm:p-8 space-y-6">
  <!-- Step Indicator -->
  <div class="flex items-center justify-between border-b border-slate-100 pb-5">
    <div class="flex items-center space-x-2">
      <span class="w-7 h-7 rounded-full bg-indigo-600 text-white font-bold text-xs flex items-center justify-center">1</span>
      <span class="font-bold text-slate-900 text-sm">Selecione o Serviço</span>
    </div>
    <span class="text-xs text-slate-400 font-medium">Passo 1 de 4</span>
  </div>

  <!-- Services List -->
  <div class="space-y-3">
    <% if @services.any? %>
      <% @services.each do |service| %>
        <%= link_to booking_professionals_path(tenant_slug: @booking_tenant.slug, service_id: service.id), class: "group block p-4 sm:p-5 rounded-2xl border border-slate-200/90 hover:border-indigo-500 hover:shadow-md transition-all bg-white" do %>
          <div class="flex items-start justify-between gap-4">
            <div class="space-y-1">
              <h3 class="font-bold text-slate-900 text-base group-hover:text-indigo-600 transition-colors">
                <%= service.name %>
              </h3>
              <% if service.description.present? %>
                <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed"><%= service.description %></p>
              <% end %>
              <div class="flex items-center gap-3 pt-2 text-xs text-slate-500 font-medium">
                <span class="inline-flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                  </svg>
                  <%= service.duration_minutes %> min
                </span>
                <span>•</span>
                <span><%= service.professionals.where(active: true).count %> profissional(is)</span>
              </div>
            </div>

            <div class="text-right flex-shrink-0">
              <span class="text-base sm:text-lg font-bold text-slate-900 block group-hover:text-indigo-600 transition-colors">
                <%= format_cents(service.price_cents, service.currency) %>
              </span>
              <span class="inline-flex items-center text-xs font-semibold text-indigo-600 mt-2 gap-0.5 group-hover:translate-x-0.5 transition-transform">
                Escolher
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                </svg>
              </span>
            </div>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <div class="py-12 text-center text-slate-400">
        <p class="text-sm font-semibold text-slate-700">Nenhum serviço disponível no momento.</p>
        <p class="text-xs mt-1">Por favor, entre em contato diretamente com o estabelecimento.</p>
      </div>
    <% end %>
  </div>
</div>
