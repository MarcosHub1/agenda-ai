<div class="max-w-3xl mx-auto space-y-6">
  <div>
    <%= link_to "← Voltar para #{@professional.name}", dashboard_professional_path(@professional), class: "text-xs font-semibold text-indigo-600 hover:text-indigo-800" %>
    <h1 class="text-2xl font-bold text-slate-900 mt-2">Folgas & Exceções de Horário</h1>
    <p class="text-sm text-slate-500 mt-1">Configure dias de folga, feriados ou horários diferenciados para <%= @professional.name %>.</p>
  </div>

  <!-- Form to Add Exception -->
  <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-sm">
    <h2 class="text-base font-bold text-slate-900 mb-4">Adicionar Nova Exceção / Bloqueio</h2>

    <%= form_with(model: [:dashboard, @professional, @new_exception], class: "space-y-4") do |f| %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :exception_date, "Data da Exceção *", class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1" %>
          <%= f.date_field :exception_date, required: true, class: "w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600" %>
        </div>

        <div>
          <%= f.label :reason, "Motivo (opcional)", class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1" %>
          <%= f.text_field :reason, placeholder: "Ex: Feriado municipal, Consulta médica", class: "w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600" %>
        </div>
      </div>

      <div class="flex items-center gap-2 pt-2">
        <%= f.check_box :is_blocked, checked: true, class: "rounded border-slate-300 text-rose-600 focus:ring-rose-500 w-4 h-4" %>
        <%= f.label :is_blocked, "Bloquear o dia inteiro (sem agendamentos)", class: "text-sm font-medium text-slate-800 cursor-pointer" %>
      </div>

      <div class="flex items-center justify-end gap-3 pt-3">
        <%= f.submit "Adicionar Exceção", class: "px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-xl text-xs shadow-sm transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <!-- Existing Exceptions List -->
  <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-sm">
    <h2 class="text-base font-bold text-slate-900 mb-4">Exceções Cadastradas</h2>

    <% if @schedule_exceptions.any? %>
      <div class="divide-y divide-slate-100">
        <% @schedule_exceptions.each do |exc| %>
          <div class="py-3.5 flex items-center justify-between">
            <div>
              <div class="flex items-center gap-2">
                <span class="text-sm font-bold text-slate-800"><%= l(exc.exception_date, format: :long) %></span>
                <% if exc.is_blocked? %>
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200">Bloqueado</span>
                <% else %>
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200"><%= exc.start_time&.strftime("%H:%M") %> - <%= exc.end_time&.strftime("%H:%M") %></span>
                <% end %>
              </div>
              <% if exc.reason.present? %>
                <p class="text-xs text-slate-500 mt-1"><%= exc.reason %></p>
              <% end %>
            </div>
            <%= button_to "Excluir", dashboard_professional_schedule_exception_path(@professional, exc), method: :delete, data: { turbo_confirm: "Excluir esta exceção?" }, class: "text-xs font-medium text-rose-600 hover:text-rose-800 px-3 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 transition-colors" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-xs text-slate-400 italic">Nenhuma exceção cadastrada.</p>
    <% end %>
  </div>
</div>
