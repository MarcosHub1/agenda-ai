<div class="max-w-3xl mx-auto space-y-6">
  <div>
    <%= link_to "← Voltar para Configurações", dashboard_settings_path, class: "text-xs font-semibold text-indigo-600 hover:text-indigo-800" %>
    <h1 class="text-2xl font-bold text-slate-900 mt-2">Editar Configurações</h1>
    <p class="text-sm text-slate-500 mt-1">Atualize os parâmetros operacionais do seu estabelecimento.</p>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200/80 p-6 sm:p-8 shadow-sm">
    <%= form_with(model: @account, url: dashboard_settings_path, method: :patch, class: "space-y-6") do |f| %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <%= f.label :name, "Nome do Estabelecimento *", class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1" %>
          <%= f.text_field :name, required: true, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600" %>
        </div>

        <div>
          <%= f.label :timezone, "Fuso Horário (Timezone)", class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1" %>
          <%= f.time_zone_select :timezone, nil, { default: "America/Sao_Paulo" }, { class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600" } %>
        </div>
      </div>

      <div class="pt-4 border-t border-slate-100 space-y-4">
        <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider">Parâmetros do Motor de Disponibilidade</h3>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Antecedência Mínima (horas)</label>
            <%= number_field_tag "account[settings][min_advance_hours]", @account.settings&.dig("min_advance_hours") || 2, min: 0, class: "w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:ring-1 focus:ring-indigo-500" %>
            <p class="text-[11px] text-slate-400 mt-1">Horas mínimas antes do slot.</p>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Antecedência Máxima (dias)</label>
            <%= number_field_tag "account[settings][max_advance_days]", @account.settings&.dig("max_advance_days") || 30, min: 1, class: "w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:ring-1 focus:ring-indigo-500" %>
            <p class="text-[11px] text-slate-400 mt-1">Dias futuros liberados na agenda.</p>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Buffer entre Slots (minutos)</label>
            <%= number_field_tag "account[settings][slot_buffer_minutes]", @account.settings&.dig("slot_buffer_minutes") || 0, min: 0, step: 5, class: "w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:ring-1 focus:ring-indigo-500" %>
            <p class="text-[11px] text-slate-400 mt-1">Intervalo extra entre clientes.</p>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
        <%= link_to "Cancelar", dashboard_settings_path, class: "px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-900" %>
        <%= f.submit "Salvar Configurações", class: "px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-xl text-sm shadow-sm transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
