<div class="space-y-6">
  <!-- Header / Welcome Banner -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-gradient-to-r from-indigo-900 to-slate-900 rounded-3xl p-6 sm:p-8 text-white shadow-xl">
    <div>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 mb-3">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Sistema Ativo
      </span>
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight">Olá, <%= Current.session&.user&.email_address&.split('@')&.first&.capitalize || "Administrador" %>! 👋</h1>
      <p class="text-sm text-slate-300 mt-1">Aqui está o resumo da sua agenda e desempenho hoje no <%= current_tenant&.name %>.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <%= link_to new_dashboard_appointment_path, class: "inline-flex items-center gap-2 px-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-medium rounded-xl shadow-md shadow-indigo-600/30 transition-colors text-sm" do %>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        <span>Novo Agendamento</span>
      <% end %>
      <%= link_to booking_path(tenant_slug: current_tenant.slug), target: "_blank", class: "inline-flex items-center gap-2 px-4 py-2.5 bg-white/10 hover:bg-white/20 text-white font-medium rounded-xl border border-white/10 transition-colors text-sm backdrop-blur" do %>
        <span>Página de Booking</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
      <% end %>
    </div>
  </div>

  <!-- KPI Cards Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Agendamentos Hoje</p>
        <h3 class="text-2xl font-bold text-slate-900 mt-1"><%= @today_appointments.count %></h3>
      </div>
      <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
        </svg>
      </div>
    </div>

    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Aguardando Confirmação</p>
        <h3 class="text-2xl font-bold text-amber-600 mt-1"><%= @pending_count %></h3>
      </div>
      <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
      </div>
    </div>

    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Confirmados</p>
        <h3 class="text-2xl font-bold text-emerald-600 mt-1"><%= @confirmed_count %></h3>
      </div>
      <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
      </div>
    </div>

    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Receita Prevista (Mês)</p>
        <h3 class="text-2xl font-bold text-indigo-700 mt-1"><%= format_cents(@month_revenue_cents) %></h3>
      </div>
      <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
      </div>
    </div>
  </div>

  <!-- Main Content Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Today's Schedule -->
    <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
      <div class="p-5 border-b border-slate-100 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="w-2.5 h-2.5 rounded-full bg-indigo-600"></div>
          <h2 class="font-bold text-slate-900 text-base">Agenda de Hoje (<%= l(Date.current, format: :short) %>)</h2>
        </div>
        <%= link_to "Ver todos", dashboard_appointments_path, class: "text-xs font-semibold text-indigo-600 hover:text-indigo-700" %>
      </div>

      <div class="divide-y divide-slate-100">
        <% if @today_appointments.any? %>
          <% @today_appointments.each do |appt| %>
            <div class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-slate-50/70 transition-colors">
              <div class="flex items-start gap-4">
                <div class="text-center px-3 py-2 bg-indigo-50 rounded-xl border border-indigo-100/80 flex-shrink-0">
                  <span class="block text-xs font-semibold text-indigo-600"><%= appt.starts_at.strftime("%H:%M") %></span>
                  <span class="block text-[10px] text-slate-500 font-medium"><%= appt.ends_at.strftime("%H:%M") %></span>
                </div>
                <div>
                  <div class="flex items-center gap-2">
                    <h4 class="font-semibold text-slate-900 text-sm"><%= appt.client&.name %></h4>
                    <%= appointment_status_badge(appt.status) %>
                  </div>
                  <p class="text-xs text-slate-500 mt-0.5">
                    <span class="font-medium text-slate-700"><%= appt.service&.name %></span> com <%= appt.professional&.name %>
                  </p>
                  <% if appt.client&.phone.present? %>
                    <p class="text-xs text-slate-400 mt-1">📞 <%= appt.client.phone %></p>
                  <% end %>
                </div>
              </div>

              <div class="flex items-center gap-2 self-end sm:self-center">
                <%= link_to "Detalhes", dashboard_appointment_path(appt), class: "text-xs font-medium px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors" %>
                <% if appt.pending? %>
                  <%= button_to "Confirmar", confirm_dashboard_appointment_path(appt), method: :patch, class: "text-xs font-medium px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white transition-colors" %>
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="p-12 text-center">
            <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-3">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
              </svg>
            </div>
            <p class="text-sm font-semibold text-slate-700">Nenhum agendamento para hoje</p>
            <p class="text-xs text-slate-400 mt-1">Os novos agendamentos feitos pelos clientes aparecerão aqui automaticamente.</p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Quick Stats & Tenant Summary -->
    <div class="space-y-6">
      <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-sm space-y-4">
        <h3 class="font-bold text-slate-900 text-base">Estrutura do Estabelecimento</h3>
        <div class="space-y-3">
          <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50">
            <div class="flex items-center gap-3">
              <span class="text-lg">👥</span>
              <div>
                <p class="text-xs font-semibold text-slate-800">Profissionais Ativos</p>
                <p class="text-xs text-slate-500"><%= @professionals_count %> cadastrados</p>
              </div>
            </div>
            <%= link_to "Gerenciar", dashboard_professionals_path, class: "text-xs font-semibold text-indigo-600 hover:text-indigo-700" %>
          </div>

          <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50">
            <div class="flex items-center gap-3">
              <span class="text-lg">✂️</span>
              <div>
                <p class="text-xs font-semibold text-slate-800">Serviços Oferecidos</p>
                <p class="text-xs text-slate-500"><%= @services_count %> cadastrados</p>
              </div>
            </div>
            <%= link_to "Gerenciar", dashboard_services_path, class: "text-xs font-semibold text-indigo-600 hover:text-indigo-700" %>
          </div>

          <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50">
            <div class="flex items-center gap-3">
              <span class="text-lg">📇</span>
              <div>
                <p class="text-xs font-semibold text-slate-800">Base de Clientes</p>
                <p class="text-xs text-slate-500"><%= @clients_count %> clientes</p>
              </div>
            </div>
            <%= link_to "Ver lista", dashboard_clients_path, class: "text-xs font-semibold text-indigo-600 hover:text-indigo-700" %>
          </div>
        </div>
      </div>

      <!-- Public Booking Link Share Card -->
      <div class="bg-gradient-to-br from-indigo-50 to-violet-50 rounded-2xl border border-indigo-100 p-5 shadow-sm">
        <h4 class="font-bold text-indigo-950 text-sm">Link de Agendamento Público</h4>
        <p class="text-xs text-indigo-700/80 mt-1 mb-3">Compartilhe este link no seu Instagram, WhatsApp e site para os clientes agendarem sozinhos:</p>
        <div class="flex items-center gap-2 bg-white rounded-xl p-2 border border-indigo-200 shadow-sm">
          <input type="text" readonly value="<%= booking_url(tenant_slug: current_tenant.slug) %>" class="text-xs text-slate-600 bg-transparent flex-1 outline-none px-1 select-all font-mono">
          <%= link_to "Abrir", booking_path(tenant_slug: current_tenant.slug), target: "_blank", class: "text-xs font-bold text-indigo-600 hover:text-indigo-800 px-2 py-1 bg-indigo-50 rounded-lg" %>
        </div>
      </div>
    </div>
  </div>
</div>
