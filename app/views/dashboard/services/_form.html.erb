<%= form_with(model: [:dashboard, service], class: "space-y-6") do |f| %>
  <% if service.errors.any? %>
    <div class="rounded-xl bg-rose-50 border border-rose-200 p-4 text-rose-800 text-sm">
      <h4 class="font-semibold mb-1">Corrija os erros:</h4>
      <ul class="list-disc list-inside text-xs space-y-0.5">
        <% service.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Nome do Serviço *", class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1" %>
    <%= f.text_field :name, required: true, placeholder: "Ex: Corte Masculino Degradê", class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600" %>
  </div>

  <div>
    <%= f.label :description, "Descrição / Detalhes (opcional)", class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1" %>
    <%= f.text_area :description, rows: 3, placeholder: "Descreva o que está incluso no serviço...", class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600" %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
      <%= f.label :duration_minutes, "Duração do Atendimento (em minutos) *", class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1" %>
      <%= f.number_field :duration_minutes, min: 5, step: 5, required: true, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600" %>
      <p class="text-[11px] text-slate-400 mt-1">Tempo total ocupado na agenda por slot.</p>
    </div>

    <div>
      <%= f.label :price, "Preço (em R$) *", class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1" %>
      <% current_price_val = service.price_cents ? (service.price_cents / 100.0) : 50.0 %>
      <%= f.number_field :price, value: current_price_val, min: 0, step: 0.50, required: true, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600" %>
      <p class="text-[11px] text-slate-400 mt-1">Valor exibido para o cliente na página pública.</p>
    </div>
  </div>

  <div>
    <span class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Profissionais que realizam este serviço</span>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 bg-slate-50 p-4 rounded-xl border border-slate-200">
      <% @professionals.each do |pro| %>
        <label class="flex items-center gap-3 p-2.5 bg-white rounded-lg border border-slate-200/80 cursor-pointer hover:border-indigo-300 transition-colors">
          <%= check_box_tag "service[professional_ids][]", pro.id, service.professional_ids.include?(pro.id), class: "rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 w-4 h-4" %>
          <div>
            <p class="text-xs font-semibold text-slate-900"><%= pro.name %></p>
            <p class="text-[11px] text-slate-500"><%= pro.email.presence || "Profissional" %></p>
          </div>
        </label>
      <% end %>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :active, class: "rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 w-4 h-4" %>
    <%= f.label :active, "Serviço ativo para agendamento online", class: "text-sm font-medium text-slate-700 cursor-pointer" %>
  </div>

  <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
    <%= link_to "Cancelar", dashboard_services_path, class: "px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-900" %>
    <%= f.submit service.new_record? ? "Criar Serviço" : "Salvar Alterações", class: "px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-xl text-sm shadow-sm transition-colors cursor-pointer" %>
  </div>
<% end %>
