<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Agendamentos</h1>
      <p class="text-sm text-slate-500 mt-1">Gerencie os atendimentos do seu estabelecimento e aprove solicitações.</p>
    </div>
    <%= link_to new_dashboard_appointment_path, class: "inline-flex items-center gap-2 px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-xl shadow-sm text-sm transition-colors" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
      <span>Novo Agendamento</span>
    <% end %>
  </div>

  <!-- Filters Bar -->
  <div class="bg-white rounded-2xl border border-slate-200/80 p-4 shadow-sm space-y-3">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <!-- Status Tabs -->
      <div class="flex flex-wrap items-center gap-1.5 bg-slate-100 p-1 rounded-xl text-xs font-medium">
        <%= link_to "Todos", dashboard_appointments_path, class: "px-3 py-1.5 rounded-lg transition-colors #{params[:status].blank? && params[:view].blank? ? 'bg-white text-slate-900 shadow-sm font-bold' : 'text-slate-600 hover:text-slate-900'}" %>
        <%= link_to "Pendentes", dashboard_appointments_path(status: :pending), class: "px-3 py-1.5 rounded-lg transition-colors #{params[:status] == 'pending' ? 'bg-white text-amber-700 shadow-sm font-bold' : 'text-slate-600 hover:text-slate-900'}" %>
        <%= link_to "Confirmados", dashboard_appointments_path(status: :confirmed), class: "px-3 py-1.5 rounded-lg transition-colors #{params[:status] == 'confirmed' ? 'bg-white text-emerald-700 shadow-sm font-bold' : 'text-slate-600 hover:text-slate-900'}" %>
        <%= link_to "Concluídos", dashboard_appointments_path(status: :completed), class: "px-3 py-1.5 rounded-lg transition-colors #{params[:status] == 'completed' ? 'bg-white text-blue-700 shadow-sm font-bold' : 'text-slate-600 hover:text-slate-900'}" %>
        <%= link_to "Cancelados", dashboard_appointments_path(status: :cancelled), class: "px-3 py-1.5 rounded-lg transition-colors #{params[:status] == 'cancelled' ? 'bg-white text-rose-700 shadow-sm font-bold' : 'text-slate-600 hover:text-slate-900'}" %>
      </div>

      <!-- Professional & Date Filter Form -->
      <%= form_with(url: dashboard_appointments_path, method: :get, class: "flex items-center gap-2") do |f| %>
        <%= f.hidden_field :status, value: params[:status] if params[:status].present? %>
        
        <%= f.select :professional_id, options_from_collection_for_select(@professionals, :id, :name, params[:professional_id]), { include_blank: "Todos Profissionais" }, onchange: "this.form.submit()", class: "rounded-xl border border-slate-300 px-3 py-1.5 text-xs text-slate-700 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>

        <%= f.date_field :date, value: params[:date], onchange: "this.form.submit()", class: "rounded-xl border border-slate-300 px-2.5 py-1.5 text-xs text-slate-700 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>

        <% if params[:professional_id].present? || params[:date].present? || params[:status].present? %>
          <%= link_to "Limpar", dashboard_appointments_path, class: "text-xs font-semibold text-rose-600 hover:text-rose-800 px-2 py-1" %>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Appointments List / Table -->
  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-200/80 text-slate-500 text-xs font-semibold uppercase tracking-wider">
            <th class="py-3.5 px-4 sm:px-6">Data & Horário</th>
            <th class="py-3.5 px-4">Cliente</th>
            <th class="py-3.5 px-4">Serviço & Profissional</th>
            <th class="py-3.5 px-4">Status</th>
            <th class="py-3.5 px-4">Valor</th>
            <th class="py-3.5 px-4 text-right">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-sm text-slate-700">
          <% if @appointments.any? %>
            <% @appointments.each do |appt| %>
              <tr class="hover:bg-slate-50/70 transition-colors">
                <!-- Date/Time -->
                <td class="py-4 px-4 sm:px-6 whitespace-nowrap">
                  <div class="font-bold text-slate-900"><%= l(appt.starts_at.to_date, format: :short) %></div>
                  <div class="text-xs text-slate-500 font-medium"><%= appt.starts_at.strftime("%H:%M") %> - <%= appt.ends_at.strftime("%H:%M") %></div>
                </td>

                <!-- Client -->
                <td class="py-4 px-4">
                  <div class="font-semibold text-slate-900"><%= appt.client&.name %></div>
                  <div class="text-xs text-slate-500">
                    <%= appt.client&.phone.presence || appt.client&.email.presence || "Sem contato" %>
                  </div>
                </td>

                <!-- Service & Pro -->
                <td class="py-4 px-4">
                  <div class="font-medium text-slate-900"><%= appt.service&.name %></div>
                  <div class="text-xs text-slate-500">com <%= appt.professional&.name %></div>
                </td>

                <!-- Status -->
                <td class="py-4 px-4 whitespace-nowrap">
                  <%= appointment_status_badge(appt.status) %>
                </td>

                <!-- Price -->
                <td class="py-4 px-4 font-bold text-slate-900 whitespace-nowrap">
                  <%= format_cents(appt.price_cents) %>
                </td>

                <!-- Actions -->
                <td class="py-4 px-4 text-right whitespace-nowrap space-x-1.5">
                  <%= link_to "Ver", dashboard_appointment_path(appt), class: "text-xs font-semibold text-slate-700 hover:text-slate-900 px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 transition-colors" %>

                  <% if appt.pending? %>
                    <%= button_to "Confirmar", confirm_dashboard_appointment_path(appt), method: :patch, class: "inline-block text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 px-2.5 py-1.5 rounded-lg transition-colors cursor-pointer" %>
                  <% end %>

                  <% if appt.confirmed? %>
                    <%= button_to "Concluir", complete_dashboard_appointment_path(appt), method: :patch, class: "inline-block text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 px-2.5 py-1.5 rounded-lg transition-colors cursor-pointer" %>
                  <% end %>

                  <% unless appt.cancelled? || appt.completed? %>
                    <%= button_to "Cancelar", cancel_dashboard_appointment_path(appt), method: :patch, data: { turbo_confirm: "Cancelar este agendamento?" }, class: "inline-block text-xs font-semibold text-rose-600 hover:text-rose-800 px-2 py-1 rounded-lg transition-colors cursor-pointer" %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="py-12 text-center text-slate-400">
                Nenhum agendamento encontrado para o filtro selecionado.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
