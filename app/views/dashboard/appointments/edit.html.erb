<div class="max-w-3xl mx-auto space-y-6">
  <div>
    <%= link_to "← Voltar para Detalhes", dashboard_appointment_path(@appointment), class: "text-xs font-semibold text-indigo-600 hover:text-indigo-800" %>
    <h1 class="text-2xl font-bold text-slate-900 mt-2">Editar / Reagendar Atendimento</h1>
    <p class="text-sm text-slate-500 mt-1">Altere o horário, profissional ou notas deste agendamento.</p>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200/80 p-6 sm:p-8 shadow-sm">
    <%= render "form", appointment: @appointment %>
  </div>
</div>
