<%= form_with(model: [:dashboard, appointment], class: "space-y-6") do |f| %>
  <% if appointment.errors.any? %>
    <div class="rounded-xl bg-rose-50 border border-rose-200 p-4 text-rose-800 text-sm">
      <h4 class="font-semibold mb-1">Corrija os erros:</h4>
      <ul class="list-disc list-inside text-xs space-y-0.5">
        <% appointment.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if appointment.new_record? %>
    <!-- Client Information (New Appointment) -->
    <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-4">
      <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider">Dados do Cliente</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <%= f.label :client_name, "Nome do Cliente *", class: "block text-xs font-semibold text-slate-700 mb-1" %>
          <%= f.text_field :client_name, value: @client_name, required: true, placeholder: "Ex: Roberto Souza", class: "w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:ring-1 focus:ring-indigo-500" %>
        </div>

        <div>
          <%= f.label :client_email, "E-mail (opcional)", class: "block text-xs font-semibold text-slate-700 mb-1" %>
          <%= f.email_field :client_email, value: @client_email, placeholder: "roberto@exemplo.com", class: "w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:ring-1 focus:ring-indigo-500" %>
        </div>

        <div>
          <%= f.label :client_phone, "Telefone / WhatsApp *", class: "block text-xs font-semibold text-slate-700 mb-1" %>
          <%= f.telephone_field :client_phone, value: @client_phone, required: true, placeholder: "(11) 99999-9999", class: "w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:ring-1 focus:ring-indigo-500" %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Service, Professional & Schedule Selection -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
      <%= f.label :service_id, "Serviço Desejado *", class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1" %>
      <%= f.collection_select :service_id, @services, :id, :name, { prompt: "Selecione um serviço" }, { required: true, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600" } %>
    </div>

    <div>
      <%= f.label :professional_id, "Profissional Responsável *", class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1" %>
      <%= f.collection_select :professional_id, @professionals, :id, :name, { prompt: "Selecione um profissional" }, { required: true, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600" } %>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
      <%= f.label :starts_at, "Data e Horário de Início *", class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1" %>
      <%= f.datetime_field :starts_at, value: appointment.starts_at&.strftime("%Y-%m-%dT%H:%M"), required: true, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600" %>
    </div>

    <div>
      <%= f.label :status, "Status do Agendamento", class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1" %>
      <%= f.select :status, Appointment.statuses.keys.map { |s| [appointment_status_badge(s), s] }, {}, { class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600" } %>
    </div>
  </div>

  <div>
    <%= f.label :notes, "Observações / Notas Internas (opcional)", class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1" %>
    <%= f.text_area :notes, rows: 3, placeholder: "Alguma preferência ou detalhe do cliente...", class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600" %>
  </div>

  <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
    <%= link_to "Cancelar", dashboard_appointments_path, class: "px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-900" %>
    <%= f.submit appointment.new_record? ? "Criar Agendamento" : "Salvar Alterações", class: "px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-xl text-sm shadow-sm transition-colors cursor-pointer" %>
  </div>
<% end %>
