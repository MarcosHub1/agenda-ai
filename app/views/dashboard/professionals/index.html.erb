<div class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Profissionais</h1>
      <p class="text-sm text-slate-500 mt-1">Gerencie a equipe, atribua serviços e defina a disponibilidade semanal.</p>
    </div>
    <%= link_to new_dashboard_professional_path, class: "inline-flex items-center gap-2 px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-xl shadow-sm text-sm transition-colors" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
      <span>Adicionar Profissional</span>
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% if @professionals.any? %>
      <% @professionals.each do |pro| %>
        <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-sm hover:border-slate-300 transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-start justify-between">
              <div class="flex items-center gap-3">
                <% if pro.avatar_url.present? %>
                  <img src="<%= pro.avatar_url %>" alt="<%= pro.name %>" class="w-12 h-12 rounded-xl object-cover border border-slate-200">
                <% else %>
                  <div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-indigo-500 to-violet-500 text-white font-bold text-lg flex items-center justify-center shadow-sm">
                    <%= pro.name.first %>
                  </div>
                <% end %>
                <div>
                  <h3 class="font-bold text-slate-900 text-base leading-snug"><%= pro.name %></h3>
                  <p class="text-xs text-slate-500"><%= pro.email.presence || "Sem e-mail cadastrado" %></p>
                </div>
              </div>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= pro.active? ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-slate-100 text-slate-600' %>">
                <%= pro.active? ? "Ativo" : "Inativo" %>
              </span>
            </div>

            <!-- Assigned Services -->
            <div class="mt-4 pt-4 border-t border-slate-100">
              <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Serviços Habilitados (<%= pro.services.count %>)</p>
              <div class="flex flex-wrap gap-1.5">
                <% if pro.services.any? %>
                  <% pro.services.each do |srv| %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-lg text-xs bg-slate-100 text-slate-700 font-medium"><%= srv.name %></span>
                  <% end %>
                <% else %>
                  <span class="text-xs text-slate-400 italic">Nenhum serviço vinculado</span>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Actions -->
          <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between">
            <%= link_to "Horários & Detalhes", dashboard_professional_path(pro), class: "text-xs font-semibold text-indigo-600 hover:text-indigo-800" %>
            <div class="flex items-center gap-2">
              <%= link_to "Editar", edit_dashboard_professional_path(pro), class: "text-xs font-medium text-slate-600 hover:text-slate-900 px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 transition-colors" %>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="col-span-full bg-white rounded-2xl border border-slate-200 p-12 text-center">
        <p class="text-base font-semibold text-slate-800">Nenhum profissional cadastrado</p>
        <p class="text-xs text-slate-500 mt-1 mb-4">Adicione profissionais para receber agendamentos.</p>
        <%= link_to "Cadastrar Primeiro Profissional", new_dashboard_professional_path, class: "inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-xl text-xs" %>
      </div>
    <% end %>
  </div>
</div>
