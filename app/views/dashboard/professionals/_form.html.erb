<%= form_with(model: [:dashboard, professional], class: "space-y-6") do |f| %>
  <% if professional.errors.any? %>
    <div class="rounded-xl bg-rose-50 border border-rose-200 p-4 text-rose-800 text-sm">
      <h4 class="font-semibold mb-1">Corrija os seguintes erros:</h4>
      <ul class="list-disc list-inside text-xs space-y-0.5">
        <% professional.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <%= f.label :name, "Nome Completo *", class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1" %>
      <%= f.text_field :name, required: true, placeholder: "Ex: Dr. Carlos Eduardo", class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600" %>
    </div>

    <div>
      <%= f.label :email, "E-mail de Contato", class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1" %>
      <%= f.email_field :email, placeholder: "carlos@exemplo.com", class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600" %>
    </div>
  </div>

  <div>
    <%= f.label :avatar_url, "URL da Foto de Perfil / Avatar (opcional)", class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1" %>
    <%= f.url_field :avatar_url, placeholder: "https://images.unsplash.com/...", class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600" %>
  </div>

  <div>
    <span class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Serviços que este profissional realiza</span>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 bg-slate-50 p-4 rounded-xl border border-slate-200">
      <% @services.each do |srv| %>
        <label class="flex items-center gap-3 p-2.5 bg-white rounded-lg border border-slate-200/80 cursor-pointer hover:border-indigo-300 transition-colors">
          <%= check_box_tag "professional[service_ids][]", srv.id, professional.service_ids.include?(srv.id), class: "rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 w-4 h-4" %>
          <div>
            <p class="text-xs font-semibold text-slate-900"><%= srv.name %></p>
            <p class="text-[11px] text-slate-500"><%= srv.duration_minutes %> min · <%= format_cents(srv.price_cents) %></p>
          </div>
        </label>
      <% end %>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :active, class: "rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 w-4 h-4" %>
    <%= f.label :active, "Profissional ativo para agendamentos online", class: "text-sm font-medium text-slate-700 cursor-pointer" %>
  </div>

  <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
    <%= link_to "Cancelar", dashboard_professionals_path, class: "px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-900" %>
    <%= f.submit professional.new_record? ? "Cadastrar Profissional" : "Salvar Alterações", class: "px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-xl text-sm shadow-sm transition-colors cursor-pointer" %>
  </div>
<% end %>
