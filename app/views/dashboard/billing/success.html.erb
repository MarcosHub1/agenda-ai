<% content_for :title, "Assinatura Confirmada" %>

<div class="max-w-xl mx-auto text-center py-12 px-4 sm:px-6">
  <div class="w-16 h-16 rounded-2xl bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto shadow-inner shadow-emerald-500/20">
    <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
    </svg>
  </div>

  <h1 class="text-3xl font-bold tracking-tight text-slate-900 mt-6">Assinatura Confirmada!</h1>
  <p class="text-slate-600 text-base mt-3">
    Parabéns! Sua assinatura do <strong>AgendaAI Pro</strong> foi ativada com sucesso. Seu estabelecimento agora conta com todos os recursos ilimitados liberados.
  </p>

  <div class="mt-8 rounded-2xl bg-slate-50 border border-slate-200 p-6 text-left space-y-3">
    <div class="flex items-center justify-between text-sm">
      <span class="text-slate-500">Conta:</span>
      <span class="font-semibold text-slate-800"><%= current_tenant&.name %></span>
    </div>
    <div class="flex items-center justify-between text-sm">
      <span class="text-slate-500">Status:</span>
      <span class="inline-flex items-center gap-1 font-semibold text-emerald-600">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Ativa
      </span>
    </div>
    <div class="flex items-center justify-between text-sm">
      <span class="text-slate-500">Recibos e Gestão:</span>
      <span class="text-slate-700">Disponíveis no portal Stripe</span>
    </div>
  </div>

  <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
    <%= link_to dashboard_root_path, class: "w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-sm font-semibold bg-indigo-600 hover:bg-indigo-500 text-white shadow-md shadow-indigo-600/20 transition-all duration-200" do %>
      <span>Ir para o Painel</span>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
      </svg>
    <% end %>

    <%= link_to dashboard_billing_path, class: "w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 rounded-xl text-sm font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 transition-all duration-200" do %>
      Ver Detalhes do Plano
    <% end %>
  </div>
</div>
