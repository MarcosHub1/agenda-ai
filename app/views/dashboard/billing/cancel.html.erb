<% content_for :title, "Checkout Cancelado" %>

<div class="max-w-xl mx-auto text-center py-12 px-4 sm:px-6">
  <div class="w-16 h-16 rounded-2xl bg-amber-100 text-amber-600 flex items-center justify-center mx-auto shadow-inner shadow-amber-500/20">
    <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
    </svg>
  </div>

  <div class="space-y-2 mt-6">
    <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900">Checkout Cancelado</h1>
    <p class="text-xs sm:text-sm text-slate-600">
      O processo de checkout no Stripe foi cancelado e nenhuma cobrança foi realizada no seu cartão.
    </p>
  </div>

  <p class="text-sm text-slate-500 mt-2">
    Ficou com alguma dúvida ou precisa de ajuda para escolher o melhor plano para o seu negócio?
  </p>

  <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
    <%= link_to dashboard_billing_path, class: "w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-sm font-semibold bg-indigo-600 hover:bg-indigo-500 text-white shadow-md shadow-indigo-600/20 transition-all duration-200" do %>
      <span>Voltar aos Planos</span>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
      </svg>
    <% end %>

    <%= link_to dashboard_root_path, class: "w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 rounded-xl text-sm font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 transition-all duration-200" do %>
      Ir para o Painel
    <% end %>
  </div>
</div>
